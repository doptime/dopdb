# dopdb 配置示例 —— 复制为 config.toml 后按需修改。
# 密钥与带凭据的连接串绝不写进本文件,只写「持有它的环境变量名」(RL4)。

[http]
addr           = ":8080"                 # HTTP 监听地址
jwt_secret_env = "DOPTIME_JWT_SECRET"    # 持有 HS256 密钥 / RS256 PEM 公钥的环境变量名
cors_origins   = ["https://app.example.com"]

# 至少要有一个 name = "default" 的数据源(框架默认数据源)。
#
# namespace 是 KVRocks 上「数据库」的替代品:KVRocks 走 Redis 协议,没有
# database-里装-collection 的概念,所以一个数据源的逻辑库就是加在所有键前面的
# 前缀。若服务端启用了 KVRocks 原生 namespace token,则由 password 选择该
# namespace,namespace 前缀仍在其内部再做一层切分。
[[kvrocks]]
name         = "default"
uri_env      = "DOPTIME_KVROCKS_URI"        # 持有连接串的环境变量名;env 优先
uri          = "redis://localhost:6666"     # 字面回退,仅开发期用;env 未设时才采用
password_env = "DOPTIME_KVROCKS_PASSWORD"   # 持有认证 token 的环境变量名
namespace    = "appdb"

# 可选:迁移期的第二数据源(WithDB("analytics") 选用)。
[[kvrocks]]
name      = "analytics"
uri       = "redis://localhost:6666"
namespace = "analytics"
